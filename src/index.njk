---
layout: layouts/base.njk
---
{%- set feature = collections.work | first %}
<h1 class="visually-hidden">{{ site.name }}: film and content studio</h1>
<section class="stage stage--home">
  <div class="stage__mark" aria-hidden="true">{% set markClass = "" %}{% include "mark.njk" %}</div>
  <div class="wrap stage__inner">
    {%- if feature %}
    <p class="stage__tag">{% if feature.data.status %}<span class="stage__status">{{ feature.data.status }}</span> / {% endif %}{{ feature.data.kind or "Film" }}</p>
    <h2 class="stage__title" data-rise><a href="{{ feature.url | url }}">{{ feature.data.title }}</a></h2>
    {%- if feature.data.summary %}<p class="stage__summary">{{ feature.data.summary }}</p>{% endif %}
    <a class="button button--onDark" href="{{ feature.url | url }}">Watch</a>
    {%- else %}
    <p class="stage__tag" data-scramble>{{ site.tagline }}</p>
    <p class="stage__title" data-rise>{{ site.name }}</p>
    {%- endif %}
  </div>
</section>

<div class="marquee" aria-hidden="true">
  <div class="marquee__track">
    {%- for half in range(0, 2) %}
    <div class="marquee__half">
      {%- for rep in range(0, 4) %}
      <span>Film</span>{% set markClass = "mark--black" %}{% include "mark.njk" %}<span>Content</span>{% include "mark.njk" %}<span>{{ site.name }}</span>{% include "mark.njk" %}
      {%- endfor %}
    </div>
    {%- endfor %}
  </div>
</div>

<div class="wrap feed">
  <section>
    <div class="sechead">
      <h2 class="label">Work</h2>
      {%- if collections.work.length > 1 %}<a class="sechead__link" href="{{ '/work/' | url }}">All work</a>{% endif %}
    </div>
    {%- if collections.work.length > 1 %}
    <ul class="films">
      {%- for film in collections.work.slice(1, 7) %}
      {% include "work-card.njk" %}
      {%- endfor %}
    </ul>
    {%- elif collections.work.length == 0 %}
    <p class="empty empty--box">Nothing here yet.</p>
    {%- endif %}
  </section>

  {%- if collections.posts.length %}
  <section>
    <div class="sechead">
      <h2 class="label">Behind the scenes</h2>
      <a class="sechead__link" href="{{ '/process/' | url }}">All posts</a>
    </div>
    <ol class="rows rows--grid">
      {%- for post in collections.posts.slice(0, 4) %}
      {% include "post-row.njk" %}
      {%- endfor %}
    </ol>
  </section>
  {%- endif %}
</div>

<section class="studio">
  <div class="wrap studio__inner">
    <div class="studio__text">
      <h2 class="label">The studio</h2>
      <p class="studio__line" data-rise>A Canadian film and content studio.</p>
      <a class="button" href="{{ '/about/' | url }}">About</a>
    </div>
    <div class="studio__contact">
      {% include "x-link.njk" %}
    </div>
  </div>
</section>
