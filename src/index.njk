---
layout: layouts/base.njk
---
{%- set feature = collections.films | first %}
<h1 class="visually-hidden">{{ site.name }}: film and content studio</h1>
{%- if feature %}
<section class="stage stage--home">
  <div class="wrap stage__inner">
    <p class="stage__tag">{% if feature.data.status %}<span class="stage__status">{{ feature.data.status }}</span> / {% endif %}{{ feature.data.kind or "Film" }}</p>
    <h2 class="stage__title"><a href="{{ feature.url | url }}">{{ feature.data.title }}</a></h2>
    {%- if feature.data.summary %}<p class="stage__summary">{{ feature.data.summary }}</p>{% endif %}
    <a class="button button--onDark" href="{{ feature.url | url }}">Follow the film</a>
  </div>
</section>
{%- else %}
<section class="stage stage--home">
  <div class="wrap stage__inner">
    <p class="stage__tag">Film and content studio</p>
    <p class="stage__title">{{ site.tagline }}</p>
  </div>
</section>
{%- endif %}
<div class="wrap feed">
  <div class="front">
    <section>
      <h2 class="label">Process</h2>
      {%- if collections.posts.length %}
      <ol class="rows">
        {%- for post in collections.posts.slice(0, 6) %}
        {% include "post-row.njk" %}
        {%- endfor %}
      </ol>
      {%- if collections.posts.length > 6 %}<p class="morelink"><a class="button" href="{{ '/process/' | url }}">All process posts</a></p>{% endif %}
      {%- else %}
      <p class="empty empty--box">Nothing here yet.</p>
      {%- endif %}
    </section>
    <section class="latest">
      <h2 class="label">The studio</h2>
      {% include "brand-panel.njk" %}
    </section>
  </div>
  {%- if collections.films.length > 1 %}
  <section>
    <h2 class="label">Films</h2>
    <ul class="films">
      {%- for film in collections.films.slice(1) %}
      {% include "film-card.njk" %}
      {%- endfor %}
    </ul>
  </section>
  {%- endif %}
</div>
