---
layout: layouts/base.njk
bare: true
pagination:
  data: site.creators
  size: 1
  alias: person
permalink: "/{{ person.slug }}/admin/"
noindex: true
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ person.name }}: post"
---
<div class="x">
  {% set backUrl = "/" + person.slug + "/" %}{% include "profile-top.njk" %}

  <form class="xform" data-login>
    <h1 class="xname">Log in</h1>
    <label class="xfield">
      <span>Password</span>
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button class="xpost" type="submit">Log in</button>
  </form>

  <div data-panel hidden>
    <form class="xcompose" data-compose>
      <div class="xcompose__avatar">{% if person.avatar %}<img src="{{ person.avatar | url }}" alt="">{% endif %}</div>
      <div class="xcompose__main">
        <textarea name="body" rows="4" maxlength="900" placeholder="Write a post" aria-label="New post" required></textarea>
        <input class="xcompose__video" type="url" name="video" placeholder="Video link (YouTube or an X post), optional" aria-label="Video link">
        <div class="xcompose__row">
          <span class="xcompose__count"><span data-count>0</span> / 900</span>
          <button class="xghost" type="button" data-logout>Log out</button>
          <button class="xpost" type="submit">Post</button>
        </div>
      </div>
    </form>
    <section data-posts="{{ person.slug }}" data-sitekey="{{ site.comments.turnstileSiteKey }}" data-name="{{ person.name }}" data-handle="@{{ person.x }}" data-avatar="{{ person.avatar | url if person.avatar else '' }}">
      <h2 class="visually-hidden">Your posts</h2>
      <ol class="xposts" data-posts-list></ol>
      <p class="xempty" data-posts-message></p>
    </section>
  </div>
  <p class="xmessage" data-message role="status"></p>
</div>
<script src="{{ '/assets/js/posts.js' | url }}?v={{ buildTime | version }}"></script>
<script>
(function () {
  var creator = "{{ person.slug }}";
  var key = "mayhem-creator-" + creator;
  var login = document.querySelector("[data-login]");
  var panel = document.querySelector("[data-panel]");
  var compose = document.querySelector("[data-compose]");
  var feed = document.querySelector("[data-posts]");
  var message = document.querySelector("[data-message]");
  var count = document.querySelector("[data-count]");
  var password = "";
  // The password is kept only for this browser tab and is forgotten when it closes
  try { password = sessionStorage.getItem(key) || ""; } catch (e) {}

  function call(method, path, body) {
    return fetch(path, {
      method: method,
      headers: { authorization: "Bearer " + password, "content-type": "application/json" },
      body: body ? JSON.stringify(body) : undefined,
    }).then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); });
  }
  function lock(text) {
    password = "";
    try { sessionStorage.removeItem(key); } catch (e) {}
    panel.hidden = true;
    login.hidden = false;
    message.textContent = text || "";
  }
  function refresh() {
    var remove = function (action, question) {
      return function (item) {
        if (!window.confirm(question)) return;
        call("POST", "/api/posts", { creator: creator, action: action, id: item.id }).then(function (res) {
          if (res.status === 401 || res.status === 429) return lock(res.data.error);
          refresh();
        });
      };
    };
    mayhemPosts.show(feed, {
      deletePost: remove("delete", "Delete this post and its replies for good?"),
      deleteReply: remove("delete-reply", "Delete this reply for good?"),
    });
  }
  function open() {
    message.textContent = "Checking.";
    call("GET", "/api/posts?creator=" + creator + "&check=1").then(function (res) {
      if (res.status !== 200) return lock(res.data.error || "Could not log in.");
      try { sessionStorage.setItem(key, password); } catch (e) {}
      login.hidden = true;
      panel.hidden = false;
      message.textContent = "";
      refresh();
    }).catch(function () { message.textContent = "Could not reach the site. Try again."; });
  }
  login.addEventListener("submit", function (event) {
    event.preventDefault();
    password = login.elements.password.value;
    login.elements.password.value = "";
    open();
  });
  compose.elements.body.addEventListener("input", function () { count.textContent = compose.elements.body.value.length; });
  compose.addEventListener("submit", function (event) {
    event.preventDefault();
    var button = compose.querySelector("button[type=submit]");
    button.disabled = true;
    var text = compose.elements.body.value.trim();
    var video = compose.elements.video.value.trim();
    if (video) text += "\n" + video;
    call("POST", "/api/posts", { creator: creator, action: "post", body: text }).then(function (res) {
      button.disabled = false;
      if (res.status === 401 || res.status === 429) return lock(res.data.error);
      if (res.status !== 200) { message.textContent = res.data.error || "Could not post."; return; }
      compose.reset();
      count.textContent = "0";
      message.textContent = "Posted.";
      refresh();
    }).catch(function () { button.disabled = false; message.textContent = "Could not reach the site. Try again."; });
  });
  document.querySelector("[data-logout]").addEventListener("click", function () { lock("Logged out."); });
  if (password) open();
})();
</script>
