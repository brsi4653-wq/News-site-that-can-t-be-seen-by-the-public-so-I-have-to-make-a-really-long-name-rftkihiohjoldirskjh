---
layout: layouts/base.njk
pagination:
  data: site.creators
  size: 1
  alias: person
permalink: "/{{ person.slug }}/admin/"
noindex: true
eleventyExcludeFromCollections: true
eleventyComputed:
  title: "{{ person.name }}: post"
---
<div class="wrap article review">
  <header class="article__header">
    <span class="tag"><a href="{{ ('/' + person.slug + '/') | url }}">{{ person.name }}</a> / Admin</span>
    <h1 class="article__headline">Post</h1>
  </header>

  <form class="comments__form" data-login>
    <label class="comments__field">
      <span>Password</span>
      <input type="password" name="password" autocomplete="current-password" required>
    </label>
    <button class="button" type="submit">Log in</button>
  </form>

  <div data-panel hidden>
    <form class="comments__form" data-compose>
      <label class="comments__field">
        <span>New post</span>
        <textarea name="body" rows="5" maxlength="1000" required></textarea>
      </label>
      <p class="comments__note"><span data-count>0</span> / 1000</p>
      <div class="share">
        <button class="button" type="submit">Post</button>
        <button class="share__btn" type="button" data-logout>Log out</button>
      </div>
    </form>
    <section class="posts" data-posts="{{ person.slug }}" data-name="{{ person.name }}" data-handle="@{{ person.x }}" data-avatar="{{ person.avatar | url if person.avatar else '' }}">
      <h2 class="label">Your posts</h2>
      <ol class="posts__list" data-posts-list></ol>
      <p class="empty" data-posts-message></p>
    </section>
  </div>
  <p class="comments__message" data-message role="status"></p>
</div>
<script src="{{ '/assets/js/posts.js' | url }}?v={{ buildTime | version }}"></script>
<script>
(function () {
  var creator = "{{ person.slug }}";
  var key = "mayhem-creator-" + creator;
  var login = document.querySelector("[data-login]");
  var panel = document.querySelector("[data-panel]");
  var compose = document.querySelector("[data-compose]");
  var feed = document.querySelector("[data-posts]");
  var message = document.querySelector("[data-message]");
  var count = document.querySelector("[data-count]");
  var password = "";
  // The password is kept only for this browser tab and is forgotten when it closes
  try { password = sessionStorage.getItem(key) || ""; } catch (e) {}

  function call(method, path, body) {
    return fetch(path, {
      method: method,
      headers: { authorization: "Bearer " + password, "content-type": "application/json" },
      body: body ? JSON.stringify(body) : undefined,
    }).then(function (r) { return r.json().then(function (d) { return { status: r.status, data: d }; }); });
  }
  function lock(text) {
    password = "";
    try { sessionStorage.removeItem(key); } catch (e) {}
    panel.hidden = true;
    login.hidden = false;
    message.textContent = text || "";
  }
  function refresh() {
    mayhemPosts.show(feed, function (post) {
      if (!window.confirm("Delete this post for good?")) return;
      call("POST", "/api/posts", { creator: creator, action: "delete", id: post.id }).then(function (res) {
        if (res.status === 401 || res.status === 429) return lock(res.data.error);
        refresh();
      });
    });
  }
  function open() {
    message.textContent = "Checking.";
    call("GET", "/api/posts?creator=" + creator + "&check=1").then(function (res) {
      if (res.status !== 200) return lock(res.data.error || "Could not log in.");
      try { sessionStorage.setItem(key, password); } catch (e) {}
      login.hidden = true;
      panel.hidden = false;
      message.textContent = "";
      refresh();
    }).catch(function () { message.textContent = "Could not reach the site. Try again."; });
  }
  login.addEventListener("submit", function (event) {
    event.preventDefault();
    password = login.elements.password.value;
    login.elements.password.value = "";
    open();
  });
  compose.elements.body.addEventListener("input", function () { count.textContent = compose.elements.body.value.length; });
  compose.addEventListener("submit", function (event) {
    event.preventDefault();
    var button = compose.querySelector("button[type=submit]");
    button.disabled = true;
    call("POST", "/api/posts", { creator: creator, action: "post", body: compose.elements.body.value }).then(function (res) {
      button.disabled = false;
      if (res.status === 401 || res.status === 429) return lock(res.data.error);
      if (res.status !== 200) { message.textContent = res.data.error || "Could not post."; return; }
      compose.reset();
      count.textContent = "0";
      message.textContent = "Posted.";
      refresh();
    }).catch(function () { button.disabled = false; message.textContent = "Could not reach the site. Try again."; });
  });
  document.querySelector("[data-logout]").addEventListener("click", function () { lock("Logged out."); });
  if (password) open();
})();
</script>
