---
layout: layouts/base.njk
bare: true
pagination:
  data: site.creators
  size: 1
  alias: person
permalink: "/{{ person.slug }}/"
eleventyComputed:
  title: "{{ person.name }}"
  description: "{{ person.name }}, {{ person.role }} of Global Mayhem."
---
<div class="tree">
  <a class="tree__back" href="{{ '/creators/' | url }}" aria-label="Back to Creators">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11H7.4l5.3-5.3-1.4-1.4L3.6 12l7.7 7.7 1.4-1.4L7.4 13H20z"/></svg>
  </a>
  <div class="tree__avatar">{% if person.avatar %}<img src="{{ person.avatar | url }}" alt="{{ person.name }}" width="400" height="400">{% else %}{{ person.name | first }}{% endif %}</div>
  <h1 class="tree__name">{{ person.name }}</h1>
  <p class="tree__role">{{ person.role }} of {{ site.name }}</p>
  <ul class="tree__links">
    {%- for link in person.links %}
    <li><a class="tree__link" href="{% if link.url.indexOf('/') == 0 %}{{ link.url | url }}{% else %}{{ link.url }}{% endif %}"{% if link.url.indexOf('http') == 0 %} rel="noopener"{% endif %}>
      <span class="tree__linkname">{{ link.name }}</span>
      {%- if link.note %}<span class="tree__linknote">{{ link.note }}</span>{% endif %}
      <svg class="tree__arrow" viewBox="0 0 24 24" aria-hidden="true"><path d="M4 11h12.6l-5.3-5.3 1.4-1.4L20.4 12l-7.7 7.7-1.4-1.4 5.3-5.3H4z"/></svg>
    </a></li>
    {%- endfor %}
  </ul>
  <a class="tree__home" href="{{ '/' | url }}">{% set markClass = "mark--pink" %}{% include "mark.njk" %}<span>{{ site.name }}</span></a>
</div>
