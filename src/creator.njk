---
layout: layouts/base.njk
bare: true
pagination:
  data: site.creators
  size: 1
  alias: person
permalink: "/{{ person.slug }}/"
eleventyComputed:
  title: "{{ person.name }}"
  description: "{{ person.name }}, {{ person.role }} of Global Mayhem."
---
<div class="x">
  {% set backUrl = "/creators/" %}{% include "profile-top.njk" %}
  <div class="xbanner">{% if person.banner %}<img src="{{ person.banner | url }}" alt="" width="1500" height="500">{% endif %}</div>
  <div class="xhead">
    <div class="xhead__row">
      <div class="xavatar">{% if person.avatar %}<img src="{{ person.avatar | url }}" alt="{{ person.name }}" width="400" height="400">{% else %}{{ person.name | first }}{% endif %}</div>
      <a class="xfollow" href="https://x.com/{{ person.x }}" rel="noopener">Follow on X</a>
    </div>
    <h1 class="xname">{{ person.name }}</h1>
    <p class="xhandle">@{{ person.x }}</p>
    <p class="xbio">{{ person.role }} of <a href="{{ '/' | url }}">{{ site.name }}</a></p>
    {%- if person.bio %}
    <p class="xbio">{{ person.bio }}</p>
    {%- endif %}
  </div>
  <div class="xtabs"><span class="xtabs__on">Posts</span></div>
  <section data-posts="{{ person.slug }}" data-sitekey="{{ site.comments.turnstileSiteKey }}" data-name="{{ person.name }}" data-handle="@{{ person.x }}" data-avatar="{{ person.avatar | url if person.avatar else '' }}">
    <h2 class="visually-hidden">Posts</h2>
    <ol class="xposts" data-posts-list></ol>
    <p class="xempty" data-posts-message>Loading.</p>
  </section>
</div>
<script src="{{ '/assets/js/posts.js' | url }}?v={{ buildTime | version }}"></script>
<script>
mayhemPosts.show(document.querySelector("[data-posts]"));
</script>
