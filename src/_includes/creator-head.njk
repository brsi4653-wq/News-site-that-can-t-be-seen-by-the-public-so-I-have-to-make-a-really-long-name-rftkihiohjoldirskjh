{#- The top of a creator card: banner, photo, name, role, X name. "linked" makes the banner, photo and name open the creator's page. -#}
<div class="creator__banner">
  {%- if linked %}<a href="{{ ('/' + person.slug + '/') | url }}" aria-label="{{ person.name }}'s page">{% endif %}
  {%- if person.banner %}<img src="{{ person.banner | url }}" alt="" width="1500" height="500">
  {%- else %}{% set markClass = "mark--pink" %}{% include "mark.njk" %}{% endif %}
  {%- if linked %}</a>{% endif %}
</div>
<div class="creator__body">
  {% if linked %}<a class="creator__avatar" href="{{ ('/' + person.slug + '/') | url }}" aria-label="{{ person.name }}'s page">{% else %}<div class="creator__avatar">{% endif %}
    {%- if person.avatar %}<img src="{{ person.avatar | url }}" alt="{{ person.name }}" width="400" height="400">
    {%- else %}{{ person.name | first }}{% endif %}
  {% if linked %}</a>{% else %}</div>{% endif %}
  {% if linked %}<h2 class="creator__name"><a href="{{ ('/' + person.slug + '/') | url }}">{{ person.name }}</a></h2>{% else %}<h1 class="creator__name">{{ person.name }}</h1>{% endif %}
  <p class="creator__role">{{ person.role }}</p>
  <p class="creator__handle">@{{ person.x }}</p>
  <a class="button button--onDark" href="https://x.com/{{ person.x }}" rel="noopener">Follow on X</a>
</div>
