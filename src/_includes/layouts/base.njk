<!doctype html>
<html lang="{{ site.language }}"{% if site.effects.length and not site.preview and not bare %} class="{% for fx in site.effects %}fx-{{ fx }} {% endfor %}"{% endif %}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle %}{% if title %}{{ title }} | {{ site.name }}{% else %}{{ site.name }}{% endif %}{% endset %}
{%- set pageDescription = description or site.description %}
{%- set canonical = page.url | absolute %}
{%- set shareImage = (ogImage or "/og/default.png") | absolute %}
<title>{{ pageTitle | safe }}</title>
<meta name="description" content="{{ pageDescription }}">
<link rel="canonical" href="{{ canonical }}">
{%- if noindex or site.preview %}
<meta name="robots" content="noindex">
{%- else %}
<meta name="robots" content="max-image-preview:large">
{%- endif %}

<meta property="og:site_name" content="{{ site.name }}">
<meta property="og:locale" content="en_CA">
<meta property="og:type" content="{% if isArticle %}article{% else %}website{% endif %}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ pageDescription }}">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ shareImage }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
{%- if isArticle %}
<meta property="article:published_time" content="{{ page.date | iso }}">
<meta property="article:modified_time" content="{{ (updated or page.date) | iso }}">
{% if section %}<meta property="article:section" content="{{ section | sectionName }}">{% endif %}
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ title or site.name }}">
<meta name="twitter:description" content="{{ pageDescription }}">
<meta name="twitter:image" content="{{ shareImage }}">
{%- if site.xHandle %}
<meta name="twitter:site" content="{{ site.xHandle }}">
{%- endif %}

<link rel="alternate" type="application/rss+xml" title="{{ site.name }}" href="{{ '/feed.xml' | absolute }}">
<link rel="icon" href="{{ '/assets/logo/mayhem-favicon.svg' | url }}" type="image/svg+xml">
<link rel="icon" href="{{ '/assets/logo/mayhem-favicon-32.png' | url }}" sizes="32x32" type="image/png">
<link rel="apple-touch-icon" href="{{ '/assets/logo/mayhem-favicon-180.png' | url }}">
<meta name="theme-color" content="{% if bare %}#000000{% else %}#111111{% endif %}">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Anton&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400;1,8..60,600&family=JetBrains+Mono:wght@400;500;700&family=Inter+Tight:wght@500;600;700&display=swap">
{%- if bare %}
<link rel="stylesheet" href="{{ '/assets/css/profile.css' | url }}?v={{ buildTime | version }}">
{%- else %}
<link rel="stylesheet" href="{{ '/assets/css/site.css' | url }}?v={{ buildTime | version }}">
{# Temporary sunset theme. Delete this one line (and the theme files) to go back to the normal look. #}
<link rel="stylesheet" href="{{ '/assets/css/theme-sunset.css' | url }}?v={{ buildTime | version }}">
{%- endif %}
{%- if schema %}
<script type="application/ld+json">{{ schema | jsonld | safe }}</script>
{%- endif %}
{%- if site.preview and not bare %}
<script>
// Preview only: switch effects on from the choices saved by the panel
(function () {
  var all = {{ site.allEffects | dump | safe }};
  var on = all;
  try { var saved = JSON.parse(localStorage.getItem("mayhem-fx")); if (Array.isArray(saved)) on = saved; } catch (e) {}
  on.forEach(function (n) { document.documentElement.classList.add("fx-" + n); });
  if (on.indexOf("transitions") > -1) document.write("<style>@view-transition { navigation: auto; }</style>");
})();
</script>
{%- elif "transitions" in site.effects %}
<style>@view-transition { navigation: auto; }</style>
{%- endif %}
{%- if (site.preview or "intro" in site.effects) and not bare %}
<script>
// The opening sequence plays once per visit, on the first page opened.
(function () {
  var root = document.documentElement;
  if (!root.classList.contains("fx-intro")) return;
  if (window.matchMedia && matchMedia("(prefers-reduced-motion: reduce)").matches) return;
  try {
    if (sessionStorage.getItem("mayhem-intro")) return;
    sessionStorage.setItem("mayhem-intro", "1");
  } catch (e) {}
  root.classList.add("intro-play");
})();
</script>
{%- endif %}
{%- if (site.preview or site.effects.length) and not bare %}
<script>
// Note when a page arrives through a page-to-page transition, so the
// headline entrance does not play on top of it
addEventListener("pagereveal", function (e) {
  if (e.viewTransition) document.documentElement.classList.add("fx-arrived");
});
</script>
<script defer src="{{ '/assets/js/fx.js' | url }}?v={{ buildTime | version }}"></script>
{%- endif %}
</head>
<body>
{%- if not bare %}
<a class="skip" href="#main">Skip to content</a>
{%- if site.preview or "intro" in site.effects %}
<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__half intro__half--top"></div>
  <div class="intro__half intro__half--bottom"></div>
  <div class="intro__center">
    <div class="intro__lock">
      {% set markClass = "mark--pink" %}{% include "mark.njk" %}
      <span class="intro__word">{% for letter in site.displayName %}<span style="--i: {{ loop.index0 }}">{{ letter }}</span>{% endfor %}</span>
    </div>
    <span class="intro__rule"></span>
    <span class="intro__line">{{ site.tagline }}</span>
  </div>
</div>
<script>
(function () {
  var root = document.documentElement;
  var intro = document.querySelector("[data-intro]");
  if (!root.classList.contains("intro-play")) return;
  var done = function () { root.classList.add("intro-done"); };
  // Length of the sequence. A theme can lengthen it by setting --intro-time (in milliseconds).
  setTimeout(done, parseInt(getComputedStyle(root).getPropertyValue("--intro-time"), 10) || 2500);
  intro.addEventListener("click", done);
  addEventListener("keydown", done, { once: true });
})();
</script>
{%- endif %}

<header class="masthead">
  <div class="wrap masthead__inner masthead__inner--nav">
    <a class="lockup" href="{{ '/' | url }}" aria-label="{{ site.displayName }} home">
      {% set markClass = "mark--pink" %}{% include "mark.njk" %}
      <span class="lockup__word">{{ site.displayName }}</span>
    </a>
    <nav class="nav" aria-label="Main">
      {%- for item in site.nav %}
      <a href="{{ item.url | url }}"{% if page.url and page.url.indexOf(item.url) == 0 %} aria-current="true"{% endif %}>{{ item.name }}</a>
      {%- endfor %}
    </nav>
  </div>
</header>

{%- if (site.preview or "ticker" in site.effects) and collections.posts.length %}
{%- set wireStories = collections.posts.slice(0, 8) %}
{%- set wireReps = (8 / wireStories.length) | round(0, "ceil") %}
<div class="wire" style="--wire-time: {{ wireStories.length * wireReps * 9 }}s">
  <span class="wire__label">New</span>
  <div class="wire__window">
    <div class="wire__track">
      {%- for half in range(0, 2) %}
      <div class="wire__half"{% if half == 1 %} aria-hidden="true"{% endif %}>
        {%- for rep in range(0, wireReps) %}
        {%- for story in wireStories %}
        <a class="wire__item" href="{{ story.url | url }}"{% if half == 1 or rep > 0 %} tabindex="-1"{% endif %}>{% set markClass = "mark--pink" %}{% include "mark.njk" %}<span>{{ story.data.title }}</span></a>
        {%- endfor %}
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
  </div>
</div>
{%- endif %}

{%- endif %}
<main id="main">
{{ content | safe }}
</main>

{%- if not bare %}
<footer class="footer">
  <div class="wrap footer__inner">
    <div class="footer__brand">
      {% set markClass = "mark--pink" %}{% include "mark.njk" %}
      <span class="footer__tagline">{{ site.name }}</span>
    </div>
    <nav class="footer__nav" aria-label="Site">
      {%- for item in site.nav %}
      <a href="{{ item.url | url }}">{{ item.name }}</a>
      {%- endfor %}
    </nav>
    <div class="socials">
      <h2 class="socials__title">Socials</h2>
      {%- for social in site.socials %}
      <a class="socials__btn" href="{{ social.url }}" rel="noopener">{{ social.name }} <span>{{ social.handle }}</span></a>
      {%- endfor %}
    </div>
    <p class="footer__legal">&copy; {{ buildTime | year }} {{ site.name }}. Made in Canada.</p>
  </div>
</footer>
<script>
// Live labels and the Breaking bar carry an end time. Once it has passed,
// remove them, so they switch off on their own without a new publish.
document.querySelectorAll("[data-until]").forEach(function (el) {
  if (Date.now() > Date.parse(el.getAttribute("data-until"))) el.remove();
});
</script>
{%- if site.preview %}{% include "fx-panel.njk" %}{% endif %}
{%- endif %}
</body>
</html>
