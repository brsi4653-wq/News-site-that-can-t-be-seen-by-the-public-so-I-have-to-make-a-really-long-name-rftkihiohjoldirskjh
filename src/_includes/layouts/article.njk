---
layout: layouts/base.njk
---
{%- if isLive %}
<div class="bar bar--live" data-until="{{ liveUntil | iso }}"><div class="wrap bar__inner"><span class="dot"></span>Live / ongoing coverage</div></div>
{%- elif breaking %}
<div class="bar bar--breaking"><div class="wrap bar__inner">Breaking</div></div>
{%- endif %}
<article class="wrap article">
  <header class="article__header">
    {% set tagSection = section %}{% include "section-tag.njk" %}
    <h1 class="article__headline">{{ title }}</h1>
    {%- if summary %}
    <p class="article__summary">{{ summary }}</p>
    {%- endif %}
    <div class="article__meta">
      <span class="article__byline">By {{ author or site.defaultAuthor }}</span>
      <span>Published <time datetime="{{ page.date | iso }}">{{ page.date | fullDate }}</time></span>
      {%- if updated %}
      <span>Updated <time datetime="{{ updated | iso }}">{{ updated | fullDate }}</time></span>
      {%- endif %}
    </div>
  </header>

  <div class="article__cols">
    <div class="article__main">
      {%- if image %}
      <figure class="article__figure">
        <img src="{{ image | url }}" alt="{{ imageAlt or '' }}" width="1200" height="675">
        {%- if imageCredit %}<figcaption>{{ imageCredit }}</figcaption>{% endif %}
      </figure>
      {%- endif %}

      {%- if quote %}
      <figure class="pullquote">
        {% set markClass = "mark--pinktext" %}{% include "mark.njk" %}
        <blockquote>{{ quote }}</blockquote>
        {%- if quoteSpeaker %}<figcaption>{{ quoteSpeaker }}</figcaption>{% endif %}
      </figure>
      {%- endif %}

      <div class="article__body">
{{ content | safe }}
      </div>

      <footer class="article__footer">
        {%- if site.xHandle %}
        Spotted a mistake? <a href="https://x.com/{{ site.xHandle | xUser }}" rel="noopener">Tell us on X at @{{ site.xHandle | xUser }}</a>. Here is <a href="{{ '/corrections/' | url }}">how we handle corrections</a>.
        {%- else %}
        <a href="{{ '/corrections/' | url }}">Spotted a mistake? Read our corrections policy.</a>
        {%- endif %}
      </footer>
    </div>

    <aside class="article__aside">
      {%- set more = collections.articles | others(page.url, 5) %}
      {%- if more.length %}
      <h2 class="label">Latest</h2>
      <ol class="rows rows--stacked">
        {%- set showSection = true %}
        {%- for story in more %}
        {% include "story-row.njk" %}
        {%- endfor %}
      </ol>
      {%- endif %}
      {% include "brand-panel.njk" %}
    </aside>
  </div>
</article>
