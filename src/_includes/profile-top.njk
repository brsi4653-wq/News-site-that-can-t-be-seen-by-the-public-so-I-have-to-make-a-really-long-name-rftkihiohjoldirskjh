<header class="xbar">
  <a class="xbar__back" href="{{ backUrl | url }}" aria-label="Back">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11H7.4l5.3-5.3-1.4-1.4L3.6 12l7.7 7.7 1.4-1.4L7.4 13H20z"/></svg>
  </a>
  <div class="xbar__text">
    <span class="xbar__name">{{ person.name }}</span>
    <span class="xbar__count" data-posts-count>&nbsp;</span>
  </div>
</header>
